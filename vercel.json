{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,data/restaurants_clean.parquet}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/public/static/$1"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}

