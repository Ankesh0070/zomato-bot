.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
.venv/
env/
ENV/

# Cached Dataset
data/*.parquet
!data/restaurants_clean.parquet
data/*.csv
data/*.json
data/cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Streamlit
.streamlit/secrets.toml

# Logs
*.log
logs/

# Docker
.dockerignore

# Package manager locks
uv.lock
